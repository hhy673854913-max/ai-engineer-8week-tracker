# ============================================================
# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
#   cp .env.example .env
# ============================================================

# ---------- 方案 A：DeepSeek（低成本，推荐起步）----------
# 控制台：https://platform.deepseek.com
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 方案 B：阿里云百炼 / 通义千问（有视觉 + 嵌入）----------
# 控制台：https://bailian.console.aliyun.com
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-plus
# DASHSCOPE_VL_MODEL=qwen-vl-max          # 多模态（Day 09）
# DASHSCOPE_EMBED_MODEL=text-embedding-v3 # 嵌入（Day 11）

# ---------- 方案 C：智谱 GLM ----------
# ZHIPU_API_KEY=xxxxxxxxxxxxxxxx.xxxxxxxx
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-4-air

# ---------- 通用（可选）----------
# 任何 OpenAI 兼容网关都可以走这三个变量，优先级最高
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# 向量库落盘位置（Day 13）
CHROMA_DIR=./chroma_db

# 可观测（Day 33，二选一，没有也能跑）
# LANGSMITH_API_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
