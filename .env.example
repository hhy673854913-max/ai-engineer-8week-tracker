# ============================================================
# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
#   Copy-Item .env.example .env
#
# 只启用一家：把对应段落的注释去掉，并把下面的 LLM_PROVIDER 改成它。
# ============================================================

# 当前使用哪家：deepseek | dashscope | zhipu | moonshot
LLM_PROVIDER=deepseek

# ---------- 方案 A：DeepSeek（低成本，推荐起步）----------
# 控制台：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 方案 B：阿里云百炼 / 通义千问（视觉 + 嵌入）----------
# 控制台：https://bailian.console.aliyun.com
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-plus
# DASHSCOPE_VL_MODEL=qwen-vl-max          # 多模态（Day 09）
# DASHSCOPE_EMBED_MODEL=text-embedding-v3 # 嵌入（Day 11）

# ---------- 方案 C：智谱 GLM ----------
# ZHIPU_API_KEY=xxxxxxxxxxxxxxxx.xxxxxxxx
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-4-air

# ---------- 方案 D：Kimi / Moonshot ----------
# 控制台：https://platform.kimi.com/console/api-keys
# 用 Kimi 时把上面第 8 行改成：LLM_PROVIDER=moonshot
# 注意：K3.1 Pro 的 temperature/top_p 是固定值，代码会自动不传；
#       输出上限字段是 max_completion_tokens，代码会自动改名。
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxx
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_MODEL=kimi-k3.1-pro
# 可选高速版（输出约 2-3 倍速，代金券不适用）
# MOONSHOT_MODEL=kimi-k3.1-pro-highspeed

# ---------- 通用（可选）----------
# 任何 OpenAI 兼容网关都可以走这三个变量，优先级最高
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=

# 成本估算单价（元 / 百万 token）。不填则用代码里的示例值 2 / 8。
# 真实价格请按各厂商官网填写，否则 cost 只是粗略参考。
# LLM_PRICE_IN=2.0
# LLM_PRICE_OUT=8.0

# 向量库落盘位置（Day 13）
CHROMA_DIR=./chroma_db

# 可观测（Day 33，二选一，没有也能跑）
# LANGSMITH_API_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
